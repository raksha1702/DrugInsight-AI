# DrugInsight AI Backend Environment Configuration

PROJECT_NAME="DrugInsight AI Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL in production; SQLite fallback available in development)
# Production PostgreSQL URL format:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/druginsight"
DATABASE_URL="sqlite+aiosqlite:///./druginsight.db"
SYNC_DATABASE_URL="sqlite:///./druginsight.db"

# Redis & Background Tasks
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# External Medicine APIs
DAILYMED_API_BASE_URL="https://dailymed.nlm.nih.gov/dailymed/services/v2"
OPENFDA_API_BASE_URL="https://api.fda.gov/drug"
OPENFDA_API_KEY=""

# AI / LLM Integration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# Storage
DOCUMENT_STORAGE_PATH="./artifacts/documents"
REPORT_STORAGE_PATH="./artifacts/reports"
MODEL_STORAGE_PATH="./artifacts/models"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
